# ---------- AI mentor (server-side only — never exposed to the browser) ----------
# Option A: Anthropic Claude (default when ANTHROPIC_API_KEY is set)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5            # default for Anthropic; e.g. claude-sonnet-5-5 or claude-haiku-5-5 to save cost/latency

# Option B: any OpenAI-compatible API (OpenAI, OpenRouter, Groq, Ollama, LM Studio …)
# AI_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Allow choosing another model in Settings (default true)
# AI_ALLOW_MODEL_OVERRIDE=true

# ---------- Protect the AI routes when deployed publicly (pick one or more) ----------
# APP_PASSCODE=choose-a-long-random-string     # enter it once in Settings → Mentori AI
# AI_REQUIRE_LOGIN=true                         # require a Supabase login
# ALLOWED_EMAILS=you@example.com                # only these Supabase users may use AI

# ---------- Supabase (optional — persistent cloud storage + login) ----------
# Without these, all data is stored in this browser (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
